<div id="contact" class="anchor-group">
    <section data-bg-section="light" data-theme-section="light" class="contact-us-section">
        <div class="container">
            <div class="contact-us__section-title">
                <h2 data-scroll-animation="bounce-children" data-split-words-nomask class="icon-title-h2">
                    <span class="icon-title-h2__row-top">
                        <span>Contact Us</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 72" fill="none" width="100%"
                            class="h2-icon">
                            <rect width="72" height="72" rx="12" fill="var(--color-light-darker)"></rect>
                            <path
                                d="M51.5 47.8C51.5 48.9046 50.6046 49.8 49.5 49.8H22.5C21.3954 49.8 20.5 48.9046 20.5 47.8V24.2C20.5 23.0954 21.3954 22.2 22.5 22.2H49.5C50.6046 22.2 51.5 23.0954 51.5 24.2V47.8Z"
                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                fill="none"></path>
                            <path d="M20.5 28.6L36 38.4L51.5 28.6" stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
                            <path d="M44 16C46.7614 16 49 18.2386 49 21V25M28 16C25.2386 16 23 18.2386 23 21V25"
                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                fill="none"></path>
                        </svg>
                    </span>
                </h2>
            </div>
            <div class="contact-us__row">
                <div class="contact-us__content">
                    <div class="contact-us__eyebrow">
                        <span class="eyebrow is--red">Get in Touch</span>
                    </div>
                    <h2 class="contact-us__title">We're here to help you move forward</h2>
                    <p class="contact-us__description">Have a question, need technical support, or want to explore
                        partnership opportunities? Our dedicated team is ready to assist you with any inquiries.</p>
                    <ul class="contact-us__list">
                        <li class="contact-us__list-item">Technical support for riders, drivers, and business partners
                        </li>
                        <li class="contact-us__list-item">Information about becoming an Orda Rides driver</li>
                        <li class="contact-us__list-item">Partnership opportunities for local businesses</li>
                        <li class="contact-us__list-item">General inquiries about our services and coverage areas</li>
                    </ul>
                    <p class="contact-us__footer-text">We value every connection and strive to respond within 24 hours.
                        Your feedback helps us build a better service for our community.</p>
                    <div class="contact-us__info-links">
                        <a href="tel:+233241293754" class="contact-us__info-link">
                            <div class="contact-us__icon-circle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                    </path>
                                </svg>
                            </div>
                        </a>
                        <a href="mailto:omariomari2@gmail.com" class="contact-us__info-link">
                            <div class="contact-us__icon-circle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                                    </path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="contact-us__form-wrapper">
                    <form class="contact-us__form">
                        <div class="contact-us__form-row">
                            <div class="contact-us__form-field">
                                <input type="text" placeholder="First name *" class="contact-us__input" required />
                            </div>
                            <div class="contact-us__form-field">
                                <input type="text" placeholder="Last name *" class="contact-us__input" required />
                            </div>
                        </div>
                        <div class="contact-us__form-field">
                            <input type="email" placeholder="Email address *" class="contact-us__input" required />
                        </div>
                        <div class="contact-us__form-field">
                            <div class="contact-us__phone-wrapper">
                                <span class="contact-us__phone-prefix">+233</span>
                                <input type="tel" placeholder="Phone number *"
                                    class="contact-us__input contact-us__phone-input" required />
                            </div>
                        </div>
                        <div class="contact-us__form-field">
                            <select class="contact-us__input contact-us__select" required>
                                <option value="">Reason for contact *</option>
                                <option value="general">General Inquiry</option>
                                <option value="support">Technical Support</option>
                                <option value="rider">Become a Rider</option>
                                <option value="driver">Become a Driver</option>
                                <option value="business">Business Partnership</option>
                                <option value="feedback">Feedback & Suggestions</option>
                                <option value="complaint">Report an Issue</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="contact-us__form-field">
                            <textarea placeholder="Your message *" class="contact-us__input contact-us__textarea"
                                rows="4" required></textarea>
                        </div>
                        <p class="contact-us__privacy">We respect your privacy. Your information will only be used to
                            respond to your inquiry and improve our services.</p>
                        <button type="submit" class="contact-us__submit-btn">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>